# Скопировать в .env и подставить реальные значения. Секреты в git не коммитим.

# Строка подключения к БД. В docker-compose host = db, локально = localhost.
# Пароль должен совпадать с POSTGRES_PASSWORD ниже.
DATABASE_URL=postgresql://appuser:CHANGE_ME_STRONG_PASSWORD@db:5432/appdb

# Список origin'ов для CORS (только реальные фронтенды прода, без localhost).
# Без домена - имя вида <IP>.sslip.io (см. DOMAIN ниже).
ORIGIN_URLS=["https://<IP>.sslip.io"]

# Токен Telegram-бота от @BotFather. Утечка = подделка входа за любого пользователя.
TELEGRAM_BOT_TOKEN=

# Redis для rate limiting. В docker-compose host = redis.
REDIS_URL=redis://redis:6379/0

# RabbitMQ для кросс-доменных событий. Пусто = события доставляются синхронно
# в том же процессе (локальный запуск без брокера, тесты).
# Учётка должна совпадать с RABBITMQ_USER/RABBITMQ_PASSWORD ниже.
RABBITMQ_URL=amqp://appuser:CHANGE_ME_STRONG_PASSWORD@rabbitmq:5672/

# Учётка RabbitMQ для docker-compose (интерполяция ${...})
RABBITMQ_USER=appuser
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Учётки Postgres для docker-compose (интерполяция ${...})
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=appdb

# Пусто = эндпоинт /metrics отключён (404). Иначе - длинный случайный токен,
# доступ: Authorization: Bearer <токен>
METRICS_TOKEN=

# false в проде - скрывает Swagger (/docs), ReDoc (/redoc) и /openapi.json
DOCS_ENABLED=false

# Домен для Caddy - под него автоматически выпускается TLS-сертификат Let's Encrypt.
# Нет своего домена? Возьми <твой-IP>.sslip.io - это DNS-имя резолвится в твой IP,
# и Let's Encrypt на него сертификат выдаёт. Купишь домен - просто поменяешь здесь.
DOMAIN=<IP>.sslip.io
