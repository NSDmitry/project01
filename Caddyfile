{$DOMAIN} {
	# Тело больше 6 МБ отсекаем здесь: FastAPI разбирает multipart до зависимостей
	# (авторизации и rate limit), поэтому без лимита на прокси неаутентифицированный
	# клиент заставляет приложение спулить на диск тело любого размера. 6 МБ - это
	# лимит загрузки картинки (5 МБ) плюс запас на оформление multipart.
	request_body {
		max_size 6MB
	}

	reverse_proxy app:8000
}
